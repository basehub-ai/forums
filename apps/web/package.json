{
  "name": "forums",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "xmcp dev & vercel env run -- next dev",
    "dev:cli": "next-term build && node .next-term/dist/cli.js",
    "publish:cli": "next-term build && cd .next-term/dist && npm publish --tag latest",
    "build:cli": "next-term build",
    "build": "VERCEL=0 xmcp build && next build && ([ \"$VERCEL_ENV\" = \"production\" ] && bun run publish:cli || true)",
    "start": "next start",
    "test": "vercel env run -- bun test",
    "lint": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --dialect=postgresql --schema=./lib/db/schema.ts --out=./lib/db/migrations"
  },
