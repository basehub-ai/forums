{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"ADMIN_USER_EMAILS",
				"AUTUMN_SECRET_KEY",
				"BETTER_AUTH_SECRET",
				"DATABASE_URL",
				"GITHUB_CLIENT_ID",
				"GITHUB_CLIENT_SECRET",
				"GITHUB_TOKEN",
				"PARALLEL_API_KEY",
				"REVALIDATE_SECRET",
				"TYPESENSE_API_KEY",
				"TYPESENSE_HOST",
				"UPSTASH_REDIS_REST_TOKEN",
				"UPSTASH_REDIS_REST_URL",
				"NPM_TOKEN"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env.production.local",
				".env.local",
				".env.production",
				".env"
			],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		}
	}
}
